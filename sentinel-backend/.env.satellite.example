# NASA GPM IMERG Early Run satellite rainfall
# Register this email first at https://registration.pps.eosdis.nasa.gov/
NASA_GPM_ENABLED=true
NASA_GPM_PPS_EMAIL=your_registered_email@example.com

# NASA currently documents the registered email as both username and
# password. Leave this empty to reuse NASA_GPM_PPS_EMAIL automatically.
NASA_GPM_PPS_PASSWORD=

# Automatic polling. IMERG has 30-minute products with about 4-5 hour
# Early Run latency, so a 30-minute polling interval is sufficient.
NASA_GPM_AUTO_COLLECTION=true
NASA_GPM_COLLECTION_INTERVAL_SECONDS=1800
NASA_GPM_CACHE_TTL_SECONDS=900
NASA_GPM_TIMEOUT_SECONDS=45
NASA_GPM_MAX_DATA_AGE_HOURS=12
NASA_GPM_MAX_DOWNLOAD_MB=64
NASA_GPM_MAX_UNCOMPRESSED_MB=64

# Optional protection for POST refresh endpoints.
# Generate a value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SATELLITE_REFRESH_API_KEY=
